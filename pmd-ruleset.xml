<?xml version="1.0" encoding="UTF-8"?>

<ruleset name="Custom HTML Rules"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
           http://pmd.sourceforge.net/ruleset/2.0.0
           https://pmd.github.io/schema/ruleset_2_0_0.xsd">

    <description>
        Prüfe nur Dateien im src-Verzeichnis
    </description>

    <include-pattern>.*/src/.*</include-pattern>

    <!-- HTML -->
    <rule ref="category/html/bestpractices.xml"/>
    <!-- <rule ref="category/html/accessibility.xml"/> --> <!-- REMOVED - not available in PMD 7.26.0 -->
    <rule ref="category/html/security.xml"/>
    <rule ref="category/html/codestyle.xml"/>

    <!-- JavaScript -->
    <rule ref="category/ecmascript/errorprone.xml"/>
    <rule ref="category/ecmascript/bestpractices.xml"/>
    <rule ref="category/ecmascript/security.xml"/>
    <rule ref="category/ecmascript/design.xml"/>

</ruleset>
